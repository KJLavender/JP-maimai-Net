rules_version = '2';

// 貼到 Firebase 控制台 → Firestore Database → 規則（Rules）→ 發布
service cloud.firestore {
  match /databases/{database}/documents {
    // 每個人只能讀寫自己的那份紀錄；其他路徑一律拒絕
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'updated', 'visited', 'favs'])
        && request.resource.data.visited is map
        && request.resource.data.favs is map;
    }
    // 🎵 B50 成績（書籤工具匯入）：JSON 字串，上限約 900KB
    match /users/{uid}/mai/{doc} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at', 'data'])
        && request.resource.data.at is number
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }
    // 🤝 好友代碼代抓：每人一份工作單，只能放「排隊中」的工作；狀態由 mai-bot 的 otogo_worker.py（管理員權限）改。
    // 上一份工作做完後要隔一段時間才能再放（抓成績 10 分鐘、好友申請 1 分鐘）；卡住超過 30 分鐘可以重放。
    match /jobs/{uid} {
      function cooled() {
        return request.time > resource.data.at + duration.value(30, 'm')
          || (!(resource.data.status in ['queued', 'running'])
            && ((resource.data.type == 'b50' && request.time > resource.data.at + duration.value(10, 'm'))
              || (resource.data.type == 'friend' && request.time > resource.data.at + duration.value(1, 'm'))));
      }
      allow read: if request.auth != null && request.auth.uid == uid;
      // 刪掉再建也要等冷卻時間，不然可以繞過頻率限制
      allow delete: if request.auth != null && request.auth.uid == uid && cooled();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['type', 'code', 'status', 'at'])
        && request.resource.data.type in ['friend', 'b50']
        && request.resource.data.code is string
        && request.resource.data.code.matches('[0-9]{13}')
        && request.resource.data.status == 'queued'
        && request.resource.data.at == request.time
        && (resource == null || cooled());
    }
    // 🏅 制霸排行榜：使用者自己選擇公開，任何人都能讀；只能寫自己的，而且只有名字和數字
    match /board/{uid} {
      function n(k, max) {
        return request.resource.data[k] is int && request.resource.data[k] >= 0 && request.resource.data[k] <= max;
      }
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'shops', 'prefs', 'tw', 'twAreas', 'areas', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && n('shops', 5000) && n('prefs', 47) && n('tw', 1000) && n('twAreas', 30)
        && request.resource.data.areas == request.resource.data.prefs + request.resource.data.twAreas
        && request.resource.data.tw <= request.resource.data.shops
        && request.resource.data.at == request.time;
    }
    // maiBind/{好友代碼}：哪個帳號送的好友申請，只有 worker 能讀寫（其他路徑一律拒絕）
  }
}
