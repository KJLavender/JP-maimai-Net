rules_version = '2';

// 貼到 Firebase 控制台 → Firestore Database → 規則（Rules）→ 發布
service cloud.firestore {
  match /databases/{database}/documents {
    // 每個人只能讀寫自己的那份紀錄；其他路徑一律拒絕
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'updated', 'visited', 'favs'])
        && request.resource.data.visited is map
        && request.resource.data.favs is map;
    }
    // 🎵 B50 成績（書籤工具匯入）：JSON 字串，上限約 900KB
    match /users/{uid}/mai/{doc} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at', 'data'])
        && request.resource.data.at is number
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }
  }
}
